# /etc/cezahukuku/api.env — sahibi root, izin 600 (sudo chmod 600 /etc/cezahukuku/api.env).
# Şifreleri buraya yazın; bu dosya depoya girmez.

ConnectionStrings__Default=Host=localhost;Port=5432;Database=cezahukuku;Username=cezahukuku;Password=DEGISTIRIN

# Açılışta veritabanı şemasını günceller (tek sunuculu kurulum).
Database__MigrateOnStartup=true

# Yüklenen PDF ve ses dosyaları; oturum çerezini şifreleyen anahtarlar.
Storage__Root=/var/lib/cezahukuku/files
DataProtection__KeysPath=/var/lib/cezahukuku/keys

# Oturum, bu kadar süre işlem yapılmazsa kapanır: "Beni hatırla" seçilmezse dakika (en az 10), seçilirse gün.
Auth__IdleTimeoutMinutes=60
Auth__RememberMeDays=14

# Hiç yönetici yoksa ilk açılışta bu hesap açılır. İlk girişten sonra şifreyi panelden değiştirip bu iki satırı
# silebilirsiniz.
Seed__AdminEmail=
Seed__AdminPassword=
