<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Yerel veritabanı şifresi gibi ayarlar repoya girmesin: dotnet user-secrets (yalnız Development'ta okunur). -->
    <UserSecretsId>cezahukuku-api</UserSecretsId>
    <!-- Derlemede OpenAPI belgesi üretilir; web istemcisi (orval) bu dosyadan tipli istemci üretir. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name cezahukuku-api</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CezaHukuku.Domain\CezaHukuku.Domain.csproj" />
    <ProjectReference Include="..\CezaHukuku.Infrastructure\CezaHukuku.Infrastructure.csproj" />
    <ProjectReference Include="..\CezaHukuku.Parsing\CezaHukuku.Parsing.csproj" />
  </ItemGroup>

</Project>
